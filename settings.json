{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(gh pr merge:*)",
      "Bash(git tag:*)",
      "Bash(git push --tags:*)",
      "Bash(git push origin --tags:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "code-modernization@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "outputStyle": "Concise",
  "attribution": {
    "commit": "🤖 Written by an agent on behalf of @jcanton",
    "pr": "🤖 Written by an agent on behalf of @jcanton"
  },
  "syncClaudeAiSkills": false,
  "maxProseWidth": 100,
  "bashOutputMaxChars": 60000,
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    }
  },
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "agentPushNotifEnabled": true
}
