{
  "permissions": {
    "allow": [
      "Bash(sinfo *)",
      "Bash(squeue *)",
      "Bash(sacct *)",
      "Bash(scontrol show *)",
      "Bash(sprio *)",
      "Bash(sreport *)",
      "Bash(gh pr merge:*)",
      "Bash(git tag:*)",
      "Bash(git push --tags:*)",
      "Bash(git push origin --tags:*)"
    ],
    "deny": [
      "Read",
      "Write",
      "Edit",
      "NotebookEdit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "EnterWorktree",
      "ExitWorktree",
      "PushNotification",
      "RemoteTrigger",
      "SendMessage",
      "ListAgents",
      "CronCreate",
      "CronDelete",
      "CronList",
      "ScheduleWakeup",
      "DesignSync",
      "LSP",
      "Monitor",
      "ReportFindings",
      "Workflow",
      "TaskOutput",
      "ToolSearch",
      "Edit(~/.claude/settings.json)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(~/.local/lib/husk/**)",
      "Read(//**/.env*)",
      "Edit(//**/.env*)",
      "Read(//**/*.env)",
      "Edit(//**/*.env)",
      "Read(//**/*.pem)",
      "Edit(//**/*.pem)",
      "Read(//**/*.key)",
      "Edit(//**/*.key)",
      "Read(//**/*.cer)",
      "Edit(//**/*.cer)",
      "Read(//**/*.crt)",
      "Edit(//**/*.crt)",
      "Read(//**/*.p12)",
      "Edit(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Edit(//**/*.pfx)",
      "Read(//**/*.jks)",
      "Edit(//**/*.jks)",
      "Read(//**/credentials)",
      "Edit(//**/credentials)",
      "Read(//**/.netrc)",
      "Edit(//**/.netrc)",
      "Read(//**/.git-credentials)",
      "Edit(//**/.git-credentials)",
      "Read(//**/.npmrc)",
      "Edit(//**/.npmrc)",
      "Read(//**/.pypirc)",
      "Edit(//**/.pypirc)",
      "Read(//**/.docker/config.json)",
      "Edit(//**/.docker/config.json)",
      "Read(//**/.ssh/**)",
      "Edit(//**/.ssh/**)",
      "Read(//**/.aws/**)",
      "Edit(//**/.aws/**)",
      "Read(//**/.kube/**)",
      "Edit(//**/.kube/**)",
      "Read(//**/.config/gcloud/**)",
      "Edit(//**/.config/gcloud/**)",
      "Read(//**/.gnupg/**)",
      "Edit(//**/.gnupg/**)",
      "Bash(nc *)",
      "Bash(socat *)"
    ],
    "defaultMode": "auto"
  },
  "enableAllProjectMcpServers": false,
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "opendatadocs.meteoswiss.ch:443"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.claude/projects"
      ],
      "denyWrite": [
        "~/.claude/settings.json",
        "~/projects/agent-config/settings.json",
        ".claude/settings.json",
        ".claude/settings.local.json",
        "~/.local/lib/husk",
        ".Rprofile",
        ".hg/hgrc"
      ],
      "denyRead": [
        "/users"
      ],
      "allowRead": [
        "./"
      ]
    },
    "seccomp": {
      "applyPath": "/users/jcanton/.local/lib/husk/apply-seccomp"
    }
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    }
  },
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true,
  "theme": "auto"
}
